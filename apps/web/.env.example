# Public Supabase settings for the web app. Copy to apps/web/.env.local.
# Local values are printed by `vp exec supabase status` (API_URL, PUBLISHABLE_KEY).
# Never put the service_role / secret key here: everything with the VITE_ prefix is shipped to the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
