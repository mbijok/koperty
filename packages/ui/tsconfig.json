{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Self-imports (`@koperty/ui/...`) resolve to the sources; also read by the shadcn CLI */
    "paths": { "@koperty/ui": ["./src"], "@koperty/ui/*": ["./src/*"], "#docs/*": ["./docs/*"] },

    /* Linting (same as apps/web) */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "docs", "scripts", ".storybook", "vite.config.ts"]
}
