{
  "name": "koperty",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "check:ai": "node scripts/check-ai.ts",
    "check:tokens": "node packages/ui/scripts/check-tokens.ts",
    "test:storybook": "vp test --project ui --project ui-dark"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "supabase": "^2.121.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  }
}
